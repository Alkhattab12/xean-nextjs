# Copy this file to .env.local for local development.
# On Vercel: Project Settings -> Environment Variables -> add each key below
# (Production, Preview, and Development as needed). Never commit the real
# values — .env.local is already git-ignored.

# --- Supabase (Auth + persistent user/quota/transaction storage) ---
# Project: xean-studio (ap-southeast-1). Get these from your Supabase
# project dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://swscfzoijklhvzavxuhk.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_EN6AhcgpfyQCyRzARPPiWA_XogPAFCo"
# service_role key — NEVER prefix this NEXT_PUBLIC_, never expose to the
# browser. Bypasses Row Level Security; used only in server-side Route
# Handlers (lib/supabase/server.ts -> createSupabaseAdminClient()).
SUPABASE_SERVICE_ROLE_KEY="PASTE_YOUR_SERVICE_ROLE_KEY_HERE"

# Required for the AI Assistant feature (/api/ai-chat, and the /ai/* paths
# proxied through /api/xean-service). Get a key at https://aistudio.google.com
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server-side API key for the free-tier downloader/tools engine.
HAIDAR_API_KEY="haidarapis-6f25844cbe964f1857decc71"

# Server-side API key for the VIP / VIP+ tier downloader/tools engine.
AUTORESBOT_API_KEY="xeanapikeyautoresbot2026"

# RamaShop QRIS payment gateway (VIP/VIP+ upgrade billing).
RAMASHOP_API_KEY="rg_beca4972517f0e334b65f9d12e19af"
RAMASHOP_API_BASE="https://ramashop.my.id/api/public"

# NOTE: the original AI-Studio build also referenced an APP_URL variable, but
# nothing in server.ts actually read it (verified) — that platform injected it
# automatically and it was unused dead config. It is intentionally dropped
# here; Vercel exposes the deployment URL itself via the VERCEL_URL env var
# if you ever need it (see https://vercel.com/docs/environment-variables/system-environment-variables).
